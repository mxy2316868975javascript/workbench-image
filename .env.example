# 复制为 .env.local 后按需填写（.env.local 已被 .gitignore 忽略）。
#
# 安全提示：VITE_* 变量会被 Vite 打包进前端产物，任何拿到构建文件的人都能读到。
# 真实密钥建议不要写在这里，而是在应用「设置」面板中运行时填写——那里只存本机 IndexedDB。
# 生产构建（npm run build）检测到名称像密钥的 VITE_* 非空会直接失败；仅在 dev 使用这里的 Key。

# ---- 生图端点 ----
VITE_DEFAULT_BASE_URL=/api/relay/v1
VITE_DEFAULT_API_KEY=
VITE_DEFAULT_MODEL=gpt-image-1

# ---- 漫画工作室文本端点（脚本 / 分镜，与生图端点解耦）----
VITE_TEXT_BASE_URL=/api/relay/v1
VITE_TEXT_API_KEY=
VITE_TEXT_MODEL=gpt-4o-mini

# ---- 内置 /api/relay 的上游地址（仅 dev / preview 生效）----
# 默认 https://api.openai.com；换成任意兼容 OpenAI 协议、且需要 HTTP/2 转发的端点。
RELAY_TARGET=https://api.openai.com
